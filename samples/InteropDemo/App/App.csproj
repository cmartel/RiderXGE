<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- C++/CLI interop assembly: referenced like any managed assembly. -->
    <ProjectReference Include="..\CppCliBridge\CppCliBridge.vcxproj" />
    <!-- Native DLL used via P/Invoke (and by CppCliBridge): build it first, but do not reference it as an assembly. -->
    <ProjectReference Include="..\NativeCore\NativeCore.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the native DLL (produced by NativeCore.vcxproj into the shared solution bin folder) next to App.exe. -->
    <None Include="..\bin\$(Platform)\$(Configuration)\NativeCore.dll" Link="NativeCore.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\bin\$(Platform)\$(Configuration)\NativeCore.pdb" Link="NativeCore.pdb" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\bin\$(Platform)\$(Configuration)\NativeCore.pdb')" />
  </ItemGroup>

</Project>
